{
  "schemaVersion": "1",
  "experimentId": "exp-autofocus-sim-001",
  "specId": "spec-autofocus-sim-001",
  "experimentType": "spatial_mapping",
  "objective": "Test simulated Raman autofocus workflow on two bounded points before any hardware use.",
  "subject": {
    "id": "SIM-AF-001",
    "kind": "simulated_focus_target",
    "label": "simulated autofocus target"
  },
  "mode": "simulation",
  "resources": [
    {
      "id": "sim-stage",
      "kind": "instrument",
      "role": "stage"
    },
    {
      "id": "sim-camera",
      "kind": "instrument",
      "role": "camera"
    },
    {
      "id": "sim-acquirer",
      "kind": "instrument",
      "role": "acquirer"
    }
  ],
  "limits": {
    "motion": {
      "xUm": {
        "minUm": 0,
        "maxUm": 100
      },
      "yUm": {
        "minUm": 0,
        "maxUm": 100
      },
      "zUm": {
        "minUm": -10,
        "maxUm": 10
      }
    },
    "powerEnergy": {
      "maxLaserPowerMw": 1,
      "maxExposureEnergyMj": 1
    },
    "acquisition": {
      "maxExposureMs": 1000,
      "maxUnits": 2
    }
  },
  "plan": {
    "kind": "points",
    "points": [
      {
        "xUm": 10,
        "yUm": 10,
        "zUm": 0
      },
      {
        "xUm": 20,
        "yUm": 20,
        "zUm": 0
      }
    ]
  },
  "domain": {
    "raman": {
      "autofocus": {
        "enabled": true,
        "every": {
          "kind": "everyNPoints",
          "n": 1
        },
        "zMinUm": -10,
        "zMaxUm": 10,
        "coarseRangeUm": 5,
        "coarseStepUm": 2.5,
        "fineRangeUm": 2,
        "fineStepUm": 0.5,
        "metric": "labspec_spot_compactness",
        "minConfidence": 0.2,
        "onFailure": "pause"
      },
      "acquisition": {
        "integrationTimeS": 0.1,
        "accumulations": 1,
        "fromNm": 100,
        "toNm": 3500,
        "saveFormat": "txt"
      }
    }
  },
  "stoppingRules": {
    "maxRuntimeMinutes": 2,
    "maxUnits": 2,
    "stopOnError": true
  },
  "operatorApprovalRequired": false
}
