{
	"schemaVersion": "1",
	"experimentId": "exp-raman-001",
	"specId": "spec-raman-001",
	"experimentType": "spatial_mapping",
	"objective": "Minimal Raman point mapping with stage motion and spectrum acquisition.",
	"subject": {
		"id": "RAMAN-HW-001",
		"kind": "calibration_sample"
	},
	"mode": "hardware",
	"resources": [
		{ "id": "mc-newton-xyz-stage", "kind": "instrument", "role": "stage" },
		{ "id": "lab-acquirer", "kind": "instrument", "role": "acquirer" },
		{ "id": "labspec-workstation", "kind": "workspace", "role": "exclusive_lab_station" }
	],
	"limits": {
		"motion": {
			"xUm": { "minUm": 0, "maxUm": 100 },
			"yUm": { "minUm": 0, "maxUm": 100 },
			"zUm": { "minUm": -20, "maxUm": 20 }
		},
		"powerEnergy": {
			"maxLaserPowerMw": 1
		},
		"acquisition": {
			"maxExposureMs": 10000,
			"maxUnits": 2
		}
	},
	"plan": {
		"kind": "points",
		"points": [
			{ "xUm": 0, "yUm": 0, "zUm": 0 },
			{ "xUm": 10, "yUm": 0, "zUm": 0 }
		]
	},
	"domain": {
		"raman": {
			"operationIntent": "acquire_only",
			"acquisition": {
				"integrationTimeS": 1,
				"accumulations": 1,
				"fromNm": 100,
				"toNm": 3500,
				"saveFormat": "txt"
			}
		}
	},
	"stoppingRules": {
		"maxRuntimeMinutes": 5,
		"maxUnits": 2,
		"stopOnError": true
	}
}
