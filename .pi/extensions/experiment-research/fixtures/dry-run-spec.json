{
	"objective": "Dry-run readiness check for a small Raman mapping workflow.",
	"sampleId": "LAB-DRY-001",
	"mode": "dry_run",
	"allowedInstruments": ["lab-stage", "lab-camera", "lab-acquirer"],
	"limits": {
		"motion": {
			"xUm": { "minUm": 0, "maxUm": 100 },
			"yUm": { "minUm": 0, "maxUm": 100 },
			"zUm": { "minUm": -10, "maxUm": 10 }
		},
		"powerEnergy": {
			"maxLaserPowerMw": 1,
			"maxExposureEnergyMj": 5
		},
		"acquisition": {
			"maxExposureMs": 100,
			"maxPoints": 4
		}
	},
	"grid": {
		"x": { "startUm": 0, "stopUm": 10, "steps": 2 },
		"y": { "startUm": 0, "stopUm": 10, "steps": 2 }
	},
	"stoppingRules": {
		"maxRuntimeMinutes": 5,
		"maxPoints": 4,
		"stopOnError": true
	},
	"operatorApprovalRequired": false
}
