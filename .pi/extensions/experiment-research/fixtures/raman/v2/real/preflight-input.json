{
	"spec": {
		"schemaVersion": "1",
		"experimentId": "exp-raman-v2-real-validation-001",
		"specId": "spec-raman-v2-real-validation-dry-run-001",
		"experimentType": "spatial_mapping",
		"objective": "Dry-run pair for the current real-capable Raman V2 validation run covering autofocus, XY correction, and spectrum acquisition without thermal waiting.",
		"subject": {
			"id": "RAMAN-V2-REAL-VALIDATION-001",
			"kind": "calibration_sample"
		},
		"mode": "dry_run",
		"resources": [
			{ "id": "mc-newton-xyz-stage", "kind": "instrument", "role": "stage" },
			{ "id": "lab-acquirer", "kind": "instrument", "role": "acquirer" },
			{ "id": "lab-camera", "kind": "instrument", "role": "camera" },
			{ "id": "labspec-workstation", "kind": "workspace", "role": "exclusive_lab_station" }
		],
		"limits": {
			"motion": {
				"xUm": { "minUm": 0, "maxUm": 100 },
				"yUm": { "minUm": 0, "maxUm": 100 },
				"zUm": { "minUm": -20, "maxUm": 20 }
			},
			"powerEnergy": {
				"maxLaserPowerMw": 1
			},
			"acquisition": {
				"maxExposureMs": 10000,
				"maxUnits": 1
			}
		},
		"plan": {
			"kind": "points",
			"points": [
				{ "xUm": 0, "yUm": 0, "zUm": 0 }
			]
		},
		"domain": {
			"raman": {
				"operationIntent": "autofocus_then_acquire",
				"autofocus": {
					"enabled": true,
					"every": "once",
					"zMinUm": -10,
					"zMaxUm": 10,
					"coarseRangeUm": 4,
					"coarseStepUm": 2,
					"fineRangeUm": 2,
					"fineStepUm": 1,
					"metric": "labspec_spot_compactness",
					"minConfidence": 0.1,
					"onFailure": "pause"
				},
				"xyCorrection": {
					"enabled": true,
					"phase": "postFocusCorrection",
					"transformArtifactId": "v2-validation-calibration",
					"minConfidence": 0.1,
					"maxCorrectionUm": 5
				},
				"acquisition": {
					"integrationTimeS": 1,
					"accumulations": 1,
					"fromNm": 100,
					"toNm": 3500,
					"saveFormat": "txt"
				}
			}
		},
		"stoppingRules": {
			"maxRuntimeMinutes": 5,
			"maxUnits": 1,
			"stopOnError": true
		}
	},
	"hardwareExecution": {
		"stageAdapter": "mc_newton_xyz",
		"stagePort": "<mc-newton-stage-port>",
		"coordinateAuditId": "<coordinate-audit-id>",
		"raman": {
			"workflowBackend": "v2_bridge",
			"acquisitionBackend": "labspec_file_bridge",
			"autofocusBackend": "labspec_file_bridge",
			"xyCorrectionBackend": "phase_correlation"
		},
		"approval": {
			"bootstrapV2ValidationRun": true
		}
	}
}
