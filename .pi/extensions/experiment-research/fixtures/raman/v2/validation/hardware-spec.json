{
	"schemaVersion": "1",
	"experimentId": "exp-raman-v2-validation-001",
	"specId": "spec-raman-v2-validation-hw-001",
	"experimentType": "spatial_mapping",
	"objective": "Minimum auditable Raman V2 hardware validation run covering autofocus, XY correction, thermal wait, and spectrum acquisition.",
	"subject": {
		"id": "RAMAN-V2-VALIDATION-001",
		"kind": "calibration_sample"
	},
	"mode": "hardware",
	"resources": [
		{ "id": "mc-newton-xyz-stage", "kind": "instrument", "role": "stage" },
		{ "id": "lab-acquirer", "kind": "instrument", "role": "acquirer" },
		{ "id": "lab-camera", "kind": "instrument", "role": "camera" },
		{ "id": "thermal-heating-stage", "kind": "instrument", "role": "sample_heating" },
		{ "id": "labspec-workstation", "kind": "workspace", "role": "exclusive_lab_station" }
	],
	"limits": {
		"motion": {
			"xUm": { "minUm": 0, "maxUm": 100 },
			"yUm": { "minUm": 0, "maxUm": 100 },
			"zUm": { "minUm": -20, "maxUm": 20 }
		},
		"powerEnergy": {
			"maxLaserPowerMw": 1
		},
		"acquisition": {
			"maxExposureMs": 10000,
			"maxUnits": 1
		}
	},
	"plan": {
		"kind": "points",
		"points": [
			{ "xUm": 0, "yUm": 0, "zUm": 0 }
		]
	},
	"domain": {
		"raman": {
			"operationIntent": "autofocus_then_acquire",
			"autofocus": {
				"enabled": true,
				"every": "once",
				"zMinUm": -10,
				"zMaxUm": 10,
				"coarseRangeUm": 4,
				"coarseStepUm": 2,
				"fineRangeUm": 2,
				"fineStepUm": 1,
				"metric": "labspec_spot_compactness",
				"minConfidence": 0.1,
				"onFailure": "pause"
			},
			"xyCorrection": {
				"enabled": true,
				"phase": "postFocusCorrection",
				"transformArtifactId": "v2-validation-calibration",
				"minConfidence": 0.1,
				"maxCorrectionUm": 5
			},
			"acquisition": {
				"integrationTimeS": 1,
				"accumulations": 1,
				"fromNm": 100,
				"toNm": 3500,
				"saveFormat": "txt"
			}
		},
		"thermal": {
			"enabled": true,
			"targetTemperatureC": 60,
			"toleranceC": 0.5,
			"stableWindowS": 5,
			"timeoutS": 60,
			"pollIntervalS": 2,
			"waitBeforeAcquisition": true
		}
	},
	"stoppingRules": {
		"maxRuntimeMinutes": 5,
		"maxUnits": 1,
		"stopOnError": true
	}
}
