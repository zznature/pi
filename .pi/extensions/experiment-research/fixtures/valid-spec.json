{
	"objective": "Map simulated Raman signal over a calibration wafer.",
	"sampleId": "SIM-001",
	"mode": "simulation",
	"allowedInstruments": ["sim-stage", "sim-camera", "sim-acquirer"],
	"limits": {
		"motion": {
			"xUm": { "minUm": 0, "maxUm": 100 },
			"yUm": { "minUm": 0, "maxUm": 100 },
			"zUm": { "minUm": -10, "maxUm": 10 }
		},
		"powerEnergy": {
			"maxLaserPowerMw": 1,
			"maxExposureEnergyMj": 5
		},
		"acquisition": {
			"maxExposureMs": 100,
			"maxPoints": 9
		}
	},
	"grid": {
		"x": { "startUm": 0, "stopUm": 20, "steps": 3 },
		"y": { "startUm": 0, "stopUm": 20, "steps": 3 }
	},
	"stoppingRules": {
		"maxRuntimeMinutes": 5,
		"maxPoints": 9,
		"stopOnError": true
	},
	"operatorApprovalRequired": false
}
